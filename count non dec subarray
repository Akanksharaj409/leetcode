
class Solution {
    public long countNonDecreasingSubarrays(int[] nums, int k) {

        int n = nums.length;
        int LOG = 1;

        while ((1 << LOG) <= n) {
            LOG++;
        }

        // Step 1: Find next greater element
        int[] nge = new int[n];
        int[] stack = new int[n];
        int top = -1;

        for (int i = n - 1; i >= 0; i--) {

            while (top >= 0 && nums[stack[top]] <= nums[i]) {
                top--;
            }

            nge[i] = (top == -1) ? n : stack[top];

            stack[++top] = i;
        }

        // Step 2: Binary lifting tables
        int[][] up = new int[LOG][n];
        long[][] sum = new long[LOG][n];

        for (int i = 0; i < n; i++) {
            up[0][i] = nge[i];

            sum[0][i] = (long) nums[i] * (nge[i] - i);
        }

        for (int j = 1; j < LOG; j++) {

            for (int i = 0; i < n; i++) {

                int mid = up[j - 1][i];

                if (mid < n) {
                    up[j][i] = up[j - 1][mid];

                    sum[j][i] =
                        sum[j - 1][i] + sum[j - 1][mid];

                } else {
                    up[j][i] = n;
                    sum[j][i] = sum[j - 1][i];
                }
            }
        }

        // Step 3: Prefix sum of original array
        long[] prefix = new long[n + 1];

        for (int i = 0; i < n; i++) {
            prefix[i + 1] = prefix[i] + nums[i];
        }

        // Step 4: Calculate required operations
        long ans = 0;

        for (int r = 0; r < n; r++) {

            int left = 0;
            int right = r;

            while (left <= right) {

                int mid = left + (right - left) / 2;

                long operations = getCost(
                    mid, r, nums, up, sum,
                    prefix, LOG
                );

                if (operations <= k) {
                    right = mid - 1;
                } else {
                    left = mid + 1;
                }
            }

            ans += r - left + 1;
        }

        return ans;
    }

    // Calculate minimum operations for [l, r]
    private long getCost(
        int l,
        int r,
        int[] nums,
        int[][] up,
        long[][] sum,
        long[] prefix,
        int LOG
    ) {

        int cur = l;
        long maxSum = 0;

        for (int j = LOG - 1; j >= 0; j--) {

            int next = up[j][cur];

            if (next <= r) {

                maxSum += sum[j][cur];

                cur = next;
            }
        }

        maxSum += (long) nums[cur] * (r - cur + 1);

        long originalSum = prefix[r + 1] - prefix[l];

        return maxSum - originalSum;
    }
}
